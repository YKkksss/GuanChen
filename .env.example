# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:30001
# 开发环境需要额外允许自定义局域网域名时，以逗号分隔填写；常见私有 IPv4 网段已默认允许。
# NEXT_ALLOWED_DEV_ORIGINS=ziwei.local,my-computer.local

# ─── 本地历史记录（可选，默认值如下）───
# SQLITE_PATH=data/ziweidoushu.sqlite

# ─── 服务端 PDF 导出（可选，默认值如下）───
# REPORT_EXPORT_DIR=data/report-exports
# 找不到系统中文字体时配置可嵌入的 TTF、OTF 或 TTC 文件。
# REPORT_PDF_FONT_PATH=C:/Windows/Fonts/NotoSansSC-VF.ttf
# REPORT_PDF_BOLD_FONT_PATH=C:/Windows/Fonts/NotoSansSC-VF.ttf

# ─── AI 上下文管理（可选，默认值如下）───
# 模型可用的总上下文窗口；请按实际模型配置，不要盲目填写供应商最大宣传值。
# AI_CONTEXT_LIMIT=32768
# 日常输入目标，超长历史会通过摘要、召回和最近轮次窗口压缩。
# AI_INPUT_TOKEN_TARGET=12000
# 为模型回答和安全余量预留 Token。
# AI_OUTPUT_RESERVE=2400
# AI_CONTEXT_SAFETY_MARGIN=1000

# 每账号每日 AI 调用上限；0 或负数表示不限制，默认 200。
# AI_DAILY_LIMIT=200

# 统一账号服务的数据根目录，生产环境使用持久化路径。
# ACCOUNT_DATA_DIR=./data/accounts
# 开放注册：1；关闭注册：0。管理员由本机命令指定。
AUTH_REGISTRATION_ENABLED=1
# HTTPS 反向代理部署时设为 1；HTTP 本机测试保留 0。
AUTH_COOKIE_SECURE=0

# HTTPS 反向代理部署时填写唯一服务来源，支持代理内部 HTTP 与外部 HTTPS。
# APP_PUBLIC_ORIGIN=https://你的服务域名
